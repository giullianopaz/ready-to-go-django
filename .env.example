# Environment: development | production | test
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Django Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_SECRET_KEY=change_this_jwt_secret_key_in_production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Database (PostgreSQL)
POSTGRES_DB=django_db
POSTGRES_USER=django
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://django:change_this_postgres_password_in_production@db:5432/django_db

# Default Superuser (Auto-created in development)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# Email (Mailpit for development)
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAILS_FROM=noreply@example.com

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=ready-to-go-django
OTEL_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# CORS / Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
